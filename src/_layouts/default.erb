<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= page_title(resource) %></title>
    <link rel="canonical" href="<%= canonical_url(resource) %>" />
    <link rel="alternate" type="application/atom+xml" title="Jordan Brock" href="/atom.xml" />
    <link rel="preload" href="/fonts/newsreader-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/css/site.css" />
    <%= live_reload_dev_js %>
  </head>
  <body>
    <div class="wrap">
      <header class="masthead">
        <a class="masthead__name" href="/">Jordan Brock</a>
        <nav><a href="/archive.html">Archive</a><a href="/photos/">Photos</a><a href="/about/">About</a></nav>
      </header>
      <main><%= yield %></main>
      <footer class="site-footer">
        <a rel="me" href="https://brocks.social/@jordan">Mastodon</a> &middot; <a href="https://pixelfed.au/jordanbrock">Pixelfed</a> &middot; <a href="/atom.xml">Feed</a>
      </footer>
    </div>
  </body>
</html>
