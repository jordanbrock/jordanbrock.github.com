---
permalink: /atom.xml
template_engine: erb
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:base="<%= site.config.url %>/">
  <title>Jordan Brock</title>
  <link href="<%= site.config.url %>/atom.xml" rel="self"/>
  <link href="<%= site.config.url %>/" />
  <updated><%= site.time.xmlschema %></updated>
  <id>http://jordanbrock.com/</id>
  <author>
    <name>Jordan Brock</name>
  </author>
  <% PostType.posts(collections.posts.resources).first(20).each do |post| %>
  <entry>
    <title><%= feed_title(post) %></title>
    <link href="<%= site.config.url %><%= post_url(post) %>"/>
    <updated><%= post.date.xmlschema %></updated>
    <id><%= "http://jordanbrock.com#{post.relative_url}" %></id>
    <content type="html"><%= feed_html(feed_body(post)) %></content>
  </entry>
  <% end %>
</feed>
