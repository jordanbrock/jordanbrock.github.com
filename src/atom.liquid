---
permalink: /atom.xml
template_engine: liquid
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Jordan Brock</title>
  <link href="{{ site.url }}/atom.xml" rel="self"/>
  <link href="{{ site.url }}/" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>http://jordanbrock.com/</id>
  <author>
    <name>Jordan Brock</name>
  </author>
  {% for post in collections.posts.resources limit:10 %}
  <entry>
    <title>{{ post.data.title | xml_escape }}</title>
    <link href="{{ site.url }}{{ post.data.permalink }}"/>
    <updated>{{ post.data.date | date_to_xmlschema }}</updated>
    <id>{{ post.absolute_url | replace: "https://", "http://" }}</id>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
