---
layout: default
title: "Tagged #:prototype-term"
permalink: /tags/:term/
prototype:
  collection: posts
  term: tag
paginate:
  per_page: 10000 # far more than any tag has: one unpaginated page per tag
---
<h1 class="article__title col"><%= data.title %></h1>
<div class="stream">
  <% paginator.resources.each do |post| %>
    <%= render PostEntry.new(resource: post) %>
  <% end %>
</div>
