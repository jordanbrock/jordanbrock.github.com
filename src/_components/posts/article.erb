<article class="article col">
  <%= render PostMeta.new(resource: @resource) %>
  <% if full? %>
    <h1 class="article__title"><%= @resource.data.title %></h1>
    <div class="prose"><%= @resource.content %></div>
  <% else %>
    <h2 class="article__title"><a href="<%= PostUrl.for(@resource) %>"><%= @resource.data.title %></a></h2>
    <div class="prose"><%= summary_html.html_safe %></div>
    <a class="more" href="<%= PostUrl.for(@resource) %>">Keep reading &rarr;</a>
  <% end %>
</article>
