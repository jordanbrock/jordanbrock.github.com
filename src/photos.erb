---
layout: default
title: Photos
permalink: /photos/
---
<% tiles = PostPhotos.tiles(collections.posts.resources) %>
<h1 class="article__title col">Photos</h1>
<% if tiles.empty? %>
  <p class="meta col">No photos yet.</p>
<% else %>
  <div class="photo-grid">
    <% tiles.each do |post, photo| %>
      <%# sizes follows the .photo-grid columns in site.css: 4 across from 36rem, 2 below, inside .wrap %>
      <a href="<%= post_url(post) %><%= PostPhotos.anchor(photo) %>"><%= render Picture.new(image: photo[:image], alt: photo[:alt], sizes: "(min-width: 56rem) 13rem, (min-width: 36rem) calc((100vw - 4rem) / 4), calc((100vw - 3rem) / 2)") %></a>
    <% end %>
  </div>
<% end %>
