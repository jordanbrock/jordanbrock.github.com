---
layout: default
title: Photos
permalink: /photos/
---
<% photos = PostType.posts(collections.posts.resources, "photo") %>
<h1 class="article__title col">Photos</h1>
<% if photos.empty? %>
  <p class="meta col">No photos yet.</p>
<% else %>
  <div class="photo-grid">
    <% photos.each do |post| %>
      <%# sizes follows the .photo-grid columns in site.css: 4 across from 36rem, 2 below, inside .wrap %>
      <a href="<%= post_url(post) %>"><%= render Picture.new(image: post.data.image.to_s, alt: FeedEntry.alt(post), sizes: "(min-width: 56rem) 13rem, (min-width: 36rem) calc((100vw - 4rem) / 4), calc((100vw - 3rem) / 2)") %></a>
    <% end %>
  </div>
<% end %>
